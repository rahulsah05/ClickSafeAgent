APP_NAME=ClickSafe API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite+aiosqlite:///./clicksafe.db
SQL_ECHO=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200

VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
REPUTATION_TIMEOUT_SECONDS=10

PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
MAX_REDIRECTS=10
MAX_HTML_BYTES=1000000
SCREENSHOT_DIR=data/screenshots
HTML_DIR=data/html
BLOCK_PRIVATE_NETWORKS=true
DNS_RESOLUTION_TIMEOUT_SECONDS=5

MAX_REQUEST_BODY_BYTES=8192
ANALYSIS_RATE_LIMIT_ENABLED=true
ANALYSIS_RATE_LIMIT_REQUESTS=5
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
